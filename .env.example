# radian.sh accounts: the same Hanko project as radian.sh. Public; it is sent to the browser.
NEXT_PUBLIC_HANKO_API_URL=https://auth.radian.sh
# Optional, server only: validate sessions against another Hanko API (tests). Leave unset in deployments.
# HANKO_SERVER_API_URL=

# Vercel AI Gateway. On Vercel, leave AI_GATEWAY_API_KEY unset: the function's OIDC token is used.
# Locally, `vercel env pull` writes VERCEL_OIDC_TOKEN (valid 12 hours), or set an API key.
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5
# AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=

# Cloudflare D1: free prompts and prompt grants. Without these, `next dev` keeps them in memory;
# a production build refuses to spend prompts (503) until they are set.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Optional: extra origins allowed to call /api, comma separated (the site's own origin is always allowed).
# APP_ORIGINS=

# Free prompts a new radian.sh account gets. Existing accounts keep their count.
# FREE_PROMPTS=1

# Development only: `d1` makes `next dev` use the configured D1 instead of a local SQLite file.
# TINYAGENT_DEV_DB=
